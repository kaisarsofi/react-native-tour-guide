# Strip Cursor/Claude attribution trailers injected into commit messages.
MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

tmp="$(mktemp)"
grep -E -v -i \
  -e '^Co-authored-by:[[:space:]]*(Cursor|Claude)' \
  -e '^Made-with:[[:space:]]*Cursor' \
  -e '^Made with Cursor' \
  "$MSG_FILE" > "$tmp"
mv "$tmp" "$MSG_FILE"
