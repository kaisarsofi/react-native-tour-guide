{
  "name": "react-native-tour-guide",
  "version": "0.1.0",
  "description": "Spotlight tour guide, coach marks and onboarding walkthroughs for React Native and Expo. Animated SVG spotlight, auto-placed tooltips, themeable, zero native modules, TypeScript.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "import": "./lib/module/index.js",
      "default": "./lib/commonjs/index.js"
    }
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "clean": "rm -rf lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx}\"",
    "release": "npm run clean && npm run typecheck && npm run build && npm publish"
  },
  "keywords": [
    "react-native",
    "expo",
    "tour",
    "tour-guide",
    "tourguide",
    "walkthrough",
    "onboarding",
    "coach-marks",
    "coachmarks",
    "spotlight",
    "showcase",
    "highlight",
    "tooltip",
    "product-tour",
    "feature-tour",
    "intro",
    "nativewind",
    "tailwind",
    "typescript"
  ],
  "author": "kaisarsofi (https://github.com/kaisarsofi)",
  "license": "MIT",
  "homepage": "https://github.com/kaisarsofi/react-native-tour-guide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaisarsofi/react-native-tour-guide.git"
  },
  "bugs": {
    "url": "https://github.com/kaisarsofi/react-native-tour-guide/issues"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": ">=3",
    "react-native-svg": ">=13"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.81.0",
    "@react-native/eslint-config": "^0.81.0",
    "@types/react": "^19.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "nativewind": "^4.1.23",
    "prettier": "^3.8.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.35.3",
    "react-native-reanimated": "~4.1.7",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": false
    },
    "react-native-svg": {
      "optional": false
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
