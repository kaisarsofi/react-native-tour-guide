{
  "name": "react-native-tour-guide",
  "version": "0.1.0",
  "description": "React Native spotlight overlay, walkthrough, coach marks, tooltip tour, and onboarding for Expo. Animated SVG spotlight, auto-placed tooltips, list/gesture tours, TypeScript, zero native modules.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    }
  },
  "files": [
    "src",
    "lib",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.tsbuildinfo",
    "!**/*.map"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "node scripts/prepare.js",
    "prepack": "bob build",
    "clean": "rm -rf lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "eslint \"src/**/*.{ts,tsx}\" && prettier --check \"src/**/*.{ts,tsx}\" && tsc --noEmit && jest",
    "pack:list": "npm pack --dry-run",
    "release": "yarn validate && yarn build && yarn pack:list && yarn npm publish"
  },
  "keywords": [
    "react-native",
    "react native",
    "expo",
    "ios",
    "android",
    "tour",
    "tour-guide",
    "tourguide",
    "rn-tourguide",
    "walkthrough",
    "app-walkthrough",
    "onboarding",
    "user-onboarding",
    "first-run",
    "coach-marks",
    "coachmarks",
    "coachmark",
    "coach-mark",
    "spotlight",
    "spotlight-overlay",
    "overlay",
    "mask",
    "hole",
    "showcase",
    "highlight",
    "highlight-view",
    "tooltip",
    "tooltip-overlay",
    "popover",
    "product-tour",
    "feature-tour",
    "guided-tour",
    "guided-walkthrough",
    "feature-discovery",
    "feature-highlight",
    "intro",
    "tutorial",
    "user-guide",
    "help-overlay",
    "nativewind",
    "tailwind",
    "typescript",
    "new-architecture",
    "fabric"
  ],
  "author": "kaisarsofi (https://github.com/kaisarsofi)",
  "license": "MIT",
  "homepage": "https://github.com/kaisarsofi/react-native-tour-guide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaisarsofi/react-native-tour-guide.git"
  },
  "bugs": {
    "url": "https://github.com/kaisarsofi/react-native-tour-guide/issues"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.71.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-svg": ">=13.0.0"
  },
  "devDependencies": {
    "@legendapp/list": "^3.3.8",
    "@react-native/babel-preset": "^0.81.0",
    "@react-native/eslint-config": "^0.81.0",
    "@shopify/flash-list": "^2.3.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.2",
    "nativewind": "^4.1.23",
    "prettier": "^3.8.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.35.3",
    "react-native-reanimated": "~4.1.7",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@shopify/flash-list|@legendapp/list)/)"
    ],
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.(test|spec).(ts|tsx)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/index.ts",
      "!src/rn-classname.ts"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "resolutions": {
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@typescript-eslint/typescript-estree": "^8.39.0"
  },
  "packageManager": "yarn@4.11.0"
}
